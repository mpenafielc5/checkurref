# Copiar como .env.local y completar. Nunca subir .env.local al repositorio.

# URL de la API (FastAPI). En local: http://localhost:8000
NEXT_PUBLIC_API_URL=http://localhost:8000

# Supabase: URL del proyecto y clave pública (anon o publishable).
# Estas dos son públicas por diseño; la seguridad la dan las reglas RLS.
# La clave service_role NUNCA va en el frontend.
NEXT_PUBLIC_SUPABASE_URL=
NEXT_PUBLIC_SUPABASE_ANON_KEY=
