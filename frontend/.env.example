# Copiar como .env.local y completar. Nunca subir .env.local al repositorio.

# URL de la API (FastAPI). En local: http://localhost:8000
NEXT_PUBLIC_API_URL=http://localhost:8000

# Supabase: URL del proyecto y clave publicable (sb_publishable_...).
# Estas dos son públicas por diseño; la seguridad la dan las reglas RLS.
# La clave secreta (sb_secret_... o service_role) NUNCA va en el frontend.
NEXT_PUBLIC_SUPABASE_URL=
NEXT_PUBLIC_SUPABASE_PUBLISHABLE_KEY=
