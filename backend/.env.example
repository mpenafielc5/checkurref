# Copiar como .env y completar. Nunca subir .env al repositorio.

ENVIRONMENT=development

# Orígenes del frontend autorizados (CORS), en formato JSON.
CORS_ORIGINS=["http://localhost:3000"]

# URL del proyecto de Supabase (la misma que NEXT_PUBLIC_SUPABASE_URL del frontend).
# Con ella la API valida los tokens de sesión usando la clave pública del proyecto.
SUPABASE_URL=https://TU-PROYECTO.supabase.co

# Clave secreta del proyecto (Supabase > Project Settings > API Keys > Secret keys,
# empieza con sb_secret_). Con ella la API guarda los PDF y crea los análisis.
# Solo en el servidor: jamás en el frontend ni en el repositorio.
SUPABASE_SERVICE_ROLE_KEY=

# Extractor de campos: anystyle (necesita Ruby y anystyle-cli) o spacy.
EXTRACTION_ENGINE=anystyle
# Comando de AnyStyle, si no está en el PATH (por ejemplo, la ruta completa a anystyle.bat).
ANYSTYLE_COMMAND=anystyle

# Correo de contacto para Crossref: con él, las consultas van a su polite pool
# (más rápido y estable). Usar un correo del equipo.
CROSSREF_MAILTO=
# Clave gratuita de OpenAlex (opcional; openalex.org > Settings > API key).
# Sin clave también funciona, con un presupuesto diario 10 veces menor.
OPENALEX_API_KEY=
